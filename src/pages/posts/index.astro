---
import Layout from "@/layouts/Layout.astro";
import projects, { byYear } from "@/data/projects";

const sorted = byYear(projects);
---

<Layout title="Projects | Aarham Haider" description="Every project Aarham Haider has published on GitHub.">
  <div class="container page">
    <h1>project archive <span class="count">({sorted.length})</span></h1>
    <p class="lede">Everything I have published on GitHub, newest first.</p>

    {sorted.length === 0 && <p class="empty">No projects are listed yet. Check GitHub for the latest work.</p>}

    {
      sorted.length > 0 && (
        <table>
          <caption class="visually-hidden">All projects</caption>
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col">Project</th>
              <th scope="col" class="col-stack">Built with</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((project) => (
              <tr>
                <td class="tabular year">{project.year}</td>
                <th scope="row">
                  <a class="title" href={project.link} target="_blank" rel="noreferrer">
                    {project.title}
                    <span class="visually-hidden"> on GitHub (opens in a new tab)</span>
                  </a>
                  {project.tagline && <span class="tagline">{project.tagline}</span>}
                  <span class="stack-inline">{project.techs.join(", ")}</span>
                </th>
                <td class="col-stack">{project.techs.join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
</Layout>

<style>
  .page {
    padding-top: var(--space-8);
  }

  h1 {
    font-size: var(--text-2xl);
    color: var(--color-accent);
  }

  .count {
    color: var(--color-muted);
    font-weight: 400;
  }

  tbody tr {
    transition: background-color 150ms ease;
  }

  tbody tr:hover {
    background: var(--row-hover);
  }

  td:first-child {
    padding-left: var(--space-3);
  }

  .lede {
    margin-top: var(--space-3);
    color: var(--color-muted);
  }

  .empty {
    margin-top: var(--space-6);
  }

  table {
    width: 100%;
    margin-top: var(--space-7);
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  thead th {
    padding-bottom: var(--space-3);
    text-align: left;
    font-family: var(--font-script);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-rule);
  }

  td,
  tbody th {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid var(--color-rule);
    font-weight: 400;
  }

  .year {
    width: 4.5rem;
    color: var(--color-muted);
  }

  .title {
    display: inline-block;
    font-family: var(--font-script);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-chalk);
    text-decoration: none;
  }

  tbody tr:hover .title {
    color: var(--color-accent);
  }

  .tagline,
  .stack-inline {
    display: block;
    color: var(--color-muted);
  }

  .col-stack {
    display: none;
  }

  td.col-stack {
    color: var(--color-accent);
    padding-right: 0;
  }

  @media (min-width: 48rem) {
    .col-stack {
      display: table-cell;
    }

    .stack-inline {
      display: none;
    }
  }
</style>
