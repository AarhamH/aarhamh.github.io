---
import type { Project } from "@/data/projects";
import { rectPath } from "@/utils/rough";
import TechList from "./TechList.astro";

type Props = Project & { index: number };

const { title, tagline, summary, techs, link, year, image, note, index } = Astro.props;
const tilt = [-1.4, 1.1, 0.8, -1][index % 4];
---

<article class="card" style={`--tilt: ${tilt}deg`}>
  {
    image && (
      <div class="photo">
        <span class="tape" aria-hidden="true" />
        <div class:list={["frame", image.fit]} style={`background:${image.background}`}>
          <img src={image.src} width={image.width} height={image.height} alt={image.alt} loading="lazy" decoding="async" />
        </div>
        <svg class="border wobble" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="ink" d={rectPath(100, 100, index * 5 + 2, 0.8)} vector-effect="non-scaling-stroke" />
        </svg>
      </div>
    )
  }
  <div class="caption">
    <div class="title-row">
      <h3>
        <a href={link} target="_blank" rel="noreferrer">
          {title}<span class="visually-hidden"> on GitHub (opens in a new tab)</span>
        </a>
      </h3>
      <span class="year">'{year.slice(2)}</span>
    </div>
    {tagline && <p class="tagline">{tagline.toLowerCase()}</p>}
    {note && <p class="note">{note}</p>}
    {summary && <p class="summary">{summary}</p>}
    <div class="techs"><TechList items={techs} label="Built with" /></div>
    <a class="repo" href={link} target="_blank" rel="noreferrer">
      view on github &rarr;<span class="visually-hidden"> {title} repository (opens in a new tab)</span>
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    transform: rotate(var(--tilt));
    transition: transform 300ms var(--draw-ease);
  }

  .card:hover {
    transform: rotate(0deg);
  }

  .photo {
    position: relative;
    padding: 10px;
  }

  .tape {
    position: absolute;
    top: -10px;
    left: 50%;
    z-index: 2;
    width: 88px;
    height: 24px;
    background: var(--tape);
    transform: translateX(-50%) rotate(calc(var(--tilt) * -2));
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cover img {
    object-fit: cover;
  }

  .contain img {
    object-fit: contain;
  }

  .logo img {
    object-fit: contain;
    padding: 12%;
  }

  .border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .caption {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-2) 0;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  h3 {
    font-size: var(--text-xl);
  }

  /* Only the title and the "view on github" link open the repo; the rest of the card is inert,
     so taps and scrolls on a phone don't navigate away. */
  .repo {
    justify-self: start;
    margin-top: var(--space-3);
    font-family: var(--font-script);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .year {
    font-family: var(--font-script);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .tagline {
    color: var(--color-chalk);
  }

  .note {
    transform: rotate(-1.5deg);
    transform-origin: left;
  }

  .summary {
    margin-top: var(--space-1);
    color: var(--color-muted);
  }

  .techs {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
