---
import {
  siAstro,
  siCplusplus,
  siDocker,
  siDotnet,
  siGit,
  siGithubactions,
  siGo,
  siGraphql,
  siHaskell,
  siJest,
  siKubernetes,
  siLangchain,
  siLinux,
  siModelcontextprotocol,
  siNextdotjs,
  siPostgresql,
  siPython,
  siPytorch,
  siReact,
  siRust,
  siSqlite,
  siTauri,
  siTensorflow,
  siTokio,
  siTypescript,
  siVuedotjs,
} from "simple-icons";

// Brands Simple Icons doesn't carry (or carries an outdated mark for) come from Devicon, see src/content/icons.
import awsSvg from "../content/icons/amazonwebservices.svg?raw";
import azureSvg from "../content/icons/azure.svg?raw";
import csharpSvg from "../content/icons/csharp.svg?raw";
import grpcSvg from "../content/icons/grpc.svg?raw";
import javaSvg from "../content/icons/java.svg?raw";
import playwrightSvg from "../content/icons/playwright.svg?raw";
import redisSvg from "../content/icons/redis.svg?raw";
import sqlServerSvg from "../content/icons/microsoftsqlserver.svg?raw";

type Props = { name: string };

const { name } = Astro.props;

const simpleIcons: Record<string, { path: string }> = {
  Astro: siAstro,
  "C++": siCplusplus,
  Docker: siDocker,
  "ASP.NET": siDotnet,
  Git: siGit,
  "GitHub Actions": siGithubactions,
  Go: siGo,
  GraphQL: siGraphql,
  Haskell: siHaskell,
  Jest: siJest,
  Kubernetes: siKubernetes,
  LangChain: siLangchain,
  Linux: siLinux,
  "Model Context Protocol": siModelcontextprotocol,
  "Next.js": siNextdotjs,
  PostgreSQL: siPostgresql,
  Python: siPython,
  PyTorch: siPytorch,
  React: siReact,
  Rust: siRust,
  SQLite: siSqlite,
  Tauri: siTauri,
  TensorFlow: siTensorflow,
  Tokio: siTokio,
  TypeScript: siTypescript,
  Vue: siVuedotjs,
};

const devicons: Record<string, string> = {
  AWS: awsSvg,
  Azure: azureSvg,
  "C#": csharpSvg,
  gRPC: grpcSvg,
  Java: javaSvg,
  Playwright: playwrightSvg,
  Redis: redisSvg,
  "SQL Server": sqlServerSvg,
};

// Concepts without a brand get a small hand-drawn glyph (24x24, stroked).
const glyphs: Record<string, string> = {
  SQL: "M5 6.5 C5 3.8 19 3.8 19 6.5 C19 9.2 5 9.2 5 6.5 Z M5 6.5 L5 17.5 C5 20.4 19 20.4 19 17.5 L19 6.5 M5 12 C5 14.8 19 14.8 19 12",
  REST: "M4 8.5 L18.5 8.5 M15 5 L18.5 8.5 L15 12 M20 15.5 L5.5 15.5 M9 12 L5.5 15.5 L9 19",
  "LLM agents": "M5 9 L19 9 L19 19.5 L5 19.5 Z M12 9 L12 5 M12 3.6 A1.4 1.4 0 1 1 12 3.61 M9 13.5 L9 14.5 M15 13.5 L15 14.5 M9.5 17 L14.5 17 M3 13 L5 13 M19 13 L21 13",
  RAG: "M5 3 L13 3 L16 6 L16 11 M5 3 L5 21 L11 21 M8 8 L13 8 M8 11 L11 11 M17 15.5 A3.5 3.5 0 1 1 17 15.49 M19.5 18 L22 20.5",
  "LLM evals": "M3.5 17 A8.5 8.5 0 0 1 20.5 17 M12 17 L16 10.5 M6 14.5 L7.2 15.2 M12 8.5 L12 10 M18 14.5 L16.8 15.2",
  Lisp: "M7.5 3.5 C3.5 8 3.5 16 7.5 20.5 M16.5 3.5 C20.5 8 20.5 16 16.5 20.5 M10 7 L14.5 17 M12.3 12 L9.5 17",
};

// Wordmark-only logos waste most of a square box, so they get a viewBox cropped to the
// drawn area (measured with getBBox) and are sized by their aspect ratio instead.
const wordmarks: Record<string, { viewBox: string; aspect: number }> = {
  Go: { viewBox: "0 7.5 24 9", aspect: 24 / 9 },
  "ASP.NET": { viewBox: "0 7.5 24 9", aspect: 24 / 9 },
  gRPC: { viewBox: "0 37.5 128 53", aspect: 128 / 53 },
  AWS: { viewBox: "0 25.5 128 77", aspect: 128 / 77 },
};

const toInline = (svg: string, viewBox?: string) =>
  svg
    .replace(/<\?xml[^>]*>/, "")
    .replace(/\s(width|height)="[^"]*"/g, "")
    .replace(/\sfill="(?!none)[^"]*"/g, "")
    .replace(/\sviewBox="[^"]*"/, viewBox ? ` viewBox="${viewBox}"` : "$&")
    .replace("<svg", '<svg aria-hidden="true" focusable="false"');

const simple = simpleIcons[name];
const devicon = devicons[name];
const glyph = glyphs[name];
const wordmark = wordmarks[name];
const wideStyle = wordmark ? `--aspect: ${wordmark.aspect.toFixed(3)}` : undefined;
---

{
  simple && (
    <svg class:list={["tech-icon", { wide: wordmark }]} style={wideStyle} viewBox={wordmark?.viewBox ?? "0 0 24 24"} aria-hidden="true">
      <path d={simple.path} />
    </svg>
  )
}
{devicon && <span class:list={["tech-icon", "devicon", { wide: wordmark }]} style={wideStyle} set:html={toInline(devicon, wordmark?.viewBox)} />}
{
  glyph && (
    <svg class="tech-icon glyph" viewBox="0 0 24 24" aria-hidden="true">
      <path d={glyph} />
    </svg>
  )
}

<style>
  .tech-icon {
    flex: none;
    display: inline-block;
    width: var(--icon-size, 1.15em);
    height: var(--icon-size, 1.15em);
    fill: var(--color-chalk);
    opacity: 0.9;
    filter: url(#chalk);
    overflow: visible;
  }

  .wide {
    height: calc(var(--icon-size, 1.15em) * 0.62);
    width: calc(var(--icon-size, 1.15em) * 0.62 * var(--aspect));
  }

  .devicon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--color-chalk);
  }

  .glyph {
    fill: none;
    stroke: var(--color-chalk);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: url(#wobble);
  }
</style>
