---
import presentation from "@/data/presentation";
import { linePath } from "@/utils/rough";

const year = new Date().getFullYear();
---

<footer class="container site-footer">
  <svg class="rule" viewBox="0 0 400 6" preserveAspectRatio="none" aria-hidden="true">
    <path class="ink muted" d={linePath(0, 3, 400, 3, 21, 0.004)} vector-effect="non-scaling-stroke"></path>
  </svg>
  <div class="row">
    <p>&copy; {year} {presentation.name.toLowerCase()}, sketched on a blackboard</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .rule {
    display: block;
    width: 100%;
    height: 6px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-4);
  }
</style>
