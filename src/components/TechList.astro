---
import TechIcon from "./TechIcon.astro";

type Props = { items: string[]; label?: string; size?: "md" | "lg" };

const { items, label, size = "md" } = Astro.props;
---

<ul role="list" class:list={["tech-list", size]} aria-label={label}>
  {
    items.map((item) => (
      <li>
        <TechIcon name={item} />
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }

  .lg {
    --icon-size: 1.9rem;
    gap: var(--space-3) var(--space-5);
  }

  .lg li {
    gap: 0.55em;
  }
</style>
