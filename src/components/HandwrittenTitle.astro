---
import { underlinePath } from "@/utils/rough";

type Props = { text: string; id?: string };

const { text, id } = Astro.props;
// Measured width of the text at font-size 100 in Caveat Bold, plus a little room for the pen.
const width = 596;
---

<h1 id={id} class="title">
  <span class="visually-hidden">{text}</span>
  <svg viewBox={`0 0 ${width} 146`} aria-hidden="true">
    <text x="4" y="96" class="hand">{text}</text>
    <path class="ink accent underline" pathLength="1" d={underlinePath(width * 0.62, 7, 10)} transform="translate(8 128)"></path>
  </svg>
</h1>

<style>
  .title {
    margin: 0;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 42rem;
    height: auto;
    overflow: visible;
  }

  .hand {
    font-family: var(--font-script);
    font-size: 100px;
    font-weight: 700;
    fill: var(--color-chalk);
    stroke: var(--color-chalk);
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-dasharray: 900;
    stroke-dashoffset: 0;
    /* Sweep left to right like a pen; each letter appears already inked as the pen passes,
       while its outline is traced over it. */
    animation:
      trace 2s ease-out 0.2s both,
      sweep 2s cubic-bezier(0.45, 0.05, 0.55, 0.95) 0.2s both;
  }

  .underline {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: underline 0.6s var(--draw-ease) 2.2s both;
  }

  @keyframes trace {
    from {
      stroke-dashoffset: 900;
    }
  }

  @keyframes sweep {
    from {
      clip-path: inset(-30% 100% -30% 0);
    }
    to {
      clip-path: inset(-30% -2% -30% 0);
    }
  }

  /* Hidden until its turn, so the round cap doesn't leave a dot before the stroke starts. */
  @keyframes underline {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
  }
</style>
