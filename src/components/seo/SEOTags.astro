---
import { SEO } from "astro-seo";
import { SITE_URL } from "@/data/config";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const { title, description, noindex } = Astro.props;

const SITE_NAME = "Aarham Haider";
const DEFAULT_DESCRIPTION =
  "Software engineer in Vancouver building billing platforms, test infrastructure, and LLM agent pipelines. Interested in backend, distributed systems, AI/ML, and databases.";

// Link previews (iMessage, Discord, Slack, LinkedIn) need absolute URLs.
const pageTitle = title || SITE_NAME;
const pageDescription = description || DEFAULT_DESCRIPTION;
const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const image = {
  url: new URL("/og-image.png", SITE_URL).href,
  width: 1200,
  height: 630,
  alt: "Aarham Haider, software engineer in Vancouver, with chalk doodles of backend, distributed systems, AI/ML, and databases.",
};
---

<head>
  <SEO
    charset="UTF-8"
    title={pageTitle}
    description={pageDescription}
    canonical={pageUrl}
    noindex={noindex || false}
    openGraph={{
      basic: {
        title: pageTitle,
        type: "website",
        image: image.url,
        url: pageUrl,
      },
      optional: {
        description: pageDescription,
        siteName: SITE_NAME,
        locale: "en_CA",
      },
      image: {
        type: "image/png",
        width: image.width,
        height: image.height,
        alt: image.alt,
      },
    }}
    twitter={{
      card: "summary_large_image",
      title: pageTitle,
      description: pageDescription,
      image: image.url,
      imageAlt: image.alt,
    }}
    extend={{
      link: [
        { rel: "icon", href: "/favicon.ico" },
        { rel: "sitemap", href: "/sitemap-index.xml" },
      ],
      meta: [
        { name: "viewport", content: "width=device-width, initial-scale=1" },
        { name: "generator", content: Astro.generator },
        { name: "theme-color", content: "#0b0b0c" },
      ],
    }}
  />
</head>
