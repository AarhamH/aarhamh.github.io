---
import TechIcon from "./TechIcon.astro";
import { circlePath, linePath, rectPath } from "@/utils/rough";

// Neural net layers for the AI/ML doodle: [x, ys[]]
const layers: [number, number[]][] = [
  [22, [24, 50, 76]],
  [60, [14, 38, 62, 86]],
  [98, [36, 64]],
];
const netEdges: string[] = [];
for (let l = 0; l < layers.length - 1; l++) {
  const [x1, ys1] = layers[l];
  const [x2, ys2] = layers[l + 1];
  for (const y1 of ys1) for (const y2 of ys2) netEdges.push(`M${x1 + 6} ${y1} L${x2 - 6} ${y2}`);
}

// Mesh for distributed systems: a hub with four peers.
const peers: [number, number][] = [
  [20, 22],
  [100, 18],
  [16, 80],
  [102, 82],
];
const hub: [number, number] = [60, 50];

// Positions are hand-placed (percent of the field) so nothing overlaps at any width.
const concepts = [
  { key: "backend", label: "backend", left: 2, top: 2, tilt: -5 },
  { key: "infra", label: "distributed systems & infra", left: 56, top: 0, tilt: 4 },
  { key: "ai", label: "ai / ml", left: 6, top: 53, tilt: 3 },
  { key: "db", label: "databases", left: 58, top: 51, tilt: -4 },
];

const icons = [
  { name: "Go", left: 42, top: 5, tilt: -8 },
  { name: "GraphQL", left: 46, top: 25, tilt: 6 },
  { name: "Rust", left: 39, top: 42, tilt: -4 },
  { name: "Kubernetes", left: 22, top: 45, tilt: 10 },
  { name: "gRPC", left: 49, top: 58, tilt: -10 },
  { name: "Docker", left: 41, top: 76, tilt: 5 },
  { name: "PyTorch", left: 1, top: 44, tilt: -6 },
  { name: "PostgreSQL", left: 49, top: 88, tilt: 8 },
  { name: "Redis", left: 90, top: 68, tilt: -9 },
  { name: "LangChain", left: 33, top: 89, tilt: 4 },
];
---

<div class="field" data-draw>
  {
    concepts.map((c, i) => (
      <figure class="concept" style={`left:${c.left}%; top:${c.top}%; --tilt:${c.tilt}deg; --delay:${i * 0.35}s; --bob:${3 + i * 0.4}s`}>
        <svg viewBox="0 0 120 100" class="wobble" aria-hidden="true">
          {c.key === "backend" &&
            [8, 38, 68].map((y, j) => (
              <g transform={`translate(18 ${y})`}>
                <path class="ink" pathLength="1" style={`--draw-delay:${0.2 + j * 0.2}s`} d={rectPath(84, 24, 70 + j, 0.8)} />
                <path class="ink muted" pathLength="1" style={`--draw-delay:${0.5 + j * 0.2}s`} d="M10 8 L40 8 M10 16 L32 16" />
                <path class="ink accent" pathLength="1" style={`--draw-delay:${0.7 + j * 0.2}s`} d={circlePath(70, 12, 3.5, 3.5, 90 + j)} />
              </g>
            ))}
          {c.key === "infra" && (
            <g>
              {peers.map((p, j) => (
                <path class="ink muted" pathLength="1" style={`--draw-delay:${0.6 + j * 0.1}s`} d={linePath(hub[0], hub[1], p[0], p[1], 50 + j, 0.05)} />
              ))}
              <path class="ink muted" pathLength="1" style="--draw-delay:1s" d={linePath(peers[0][0], peers[0][1], peers[1][0], peers[1][1], 58, 0.04)} />
              <path class="ink muted" pathLength="1" style="--draw-delay:1.1s" d={linePath(peers[2][0], peers[2][1], peers[3][0], peers[3][1], 59, 0.04)} />
              {peers.map((p, j) => (
                <path class="ink" pathLength="1" style={`--draw-delay:${0.2 + j * 0.12}s`} d={circlePath(p[0], p[1], 10, 10, 60 + j)} />
              ))}
              <path class="ink accent" pathLength="1" style="--draw-delay:0.1s" d={circlePath(hub[0], hub[1], 13, 13, 66)} />
            </g>
          )}
          {c.key === "ai" && (
            <g>
              {netEdges.map((d, j) => (
                <path class="ink muted thin" pathLength="1" style={`--draw-delay:${0.6 + (j % 6) * 0.06}s`} d={d} />
              ))}
              {layers.flatMap(([x, ys], l) =>
                ys.map((y, j) => (
                  <path class:list={["ink", { accent: l === 2 }]} pathLength="1" style={`--draw-delay:${0.15 + l * 0.2 + j * 0.05}s`} d={circlePath(x, y, 6, 6, l * 10 + j + 1)} />
                ))
              )}
            </g>
          )}
          {c.key === "db" && (
            <g>
              <path class="ink" pathLength="1" style="--draw-delay:0.2s" d={circlePath(60, 18, 34, 10, 80)} />
              <path class="ink" pathLength="1" style="--draw-delay:0.5s" d="M26 18 L26 80 C26 95 94 95 94 80 L94 18" />
              <path class="ink muted" pathLength="1" style="--draw-delay:0.8s" d="M26 39 C26 53 94 53 94 39" />
              <path class="ink accent" pathLength="1" style="--draw-delay:1s" d="M26 59 C26 73 94 73 94 59" />
            </g>
          )}
        </svg>
        <figcaption>{c.label}</figcaption>
      </figure>
    ))
  }

  {
    icons.map((icon, i) => (
      <span class="logo" title={icon.name} style={`left:${icon.left}%; top:${icon.top}%; --tilt:${icon.tilt}deg; --delay:${0.8 + i * 0.12}s; --bob:${2.4 + (i % 4) * 0.5}s`}>
        <TechIcon name={icon.name} />
        <span class="visually-hidden">{icon.name}</span>
      </span>
    ))
  }
</div>

<style>
  .field {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.92;
  }

  .concept,
  .logo {
    position: absolute;
    margin: 0;
    transform: rotate(var(--tilt));
    animation: bob var(--bob) ease-in-out var(--delay) infinite alternate;
  }

  .concept {
    width: 36%;
    display: grid;
    justify-items: center;
  }

  .concept svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .thin {
    --ink-width: 1.2;
  }

  figcaption {
    margin-top: 0.2em;
    font-family: var(--font-script);
    font-size: clamp(1.05rem, 0.8rem + 0.9vw, 1.5rem);
    font-weight: 700;
    line-height: 1;
    text-align: center;
    color: var(--color-chalk);
  }

  .logo {
    display: grid;
    place-items: center;
    font-size: clamp(1.35rem, 1rem + 1.2vw, 2rem);
    opacity: 0.85;
  }

  /* Logos fade in after the doodles start drawing. */
  :global(.js) .field:not(.is-drawn) .logo {
    opacity: 0;
  }

  .logo {
    transition: opacity 0.6s ease var(--delay);
  }

  @keyframes bob {
    from {
      transform: translateY(0) rotate(var(--tilt));
    }
    to {
      transform: translateY(-6px) rotate(calc(var(--tilt) * -0.4));
    }
  }
</style>
