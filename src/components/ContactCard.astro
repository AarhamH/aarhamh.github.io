---
import { siGithub } from "simple-icons";
import presentation from "@/data/presentation";
import { rectPath } from "@/utils/rough";

// LinkedIn isn't in Simple Icons, so this is the outline mark from src/content/socials/_linkedin.svg.
const linkedinPath =
  "M5 1.25a2.75 2.75 0 1 0 0 5.5a2.75 2.75 0 0 0 0-5.5ZM3.75 4a1.25 1.25 0 1 1 2.5 0a1.25 1.25 0 0 1-2.5 0Zm-1.5 4A.75.75 0 0 1 3 7.25h4a.75.75 0 0 1 .75.75v13a.75.75 0 0 1-.75.75H3a.75.75 0 0 1-.75-.75V8Zm1.5.75v11.5h2.5V8.75h-2.5ZM9.25 8a.75.75 0 0 1 .75-.75h4a.75.75 0 0 1 .75.75v.434l.435-.187a7.792 7.792 0 0 1 2.358-.595C20.318 7.4 22.75 9.58 22.75 12.38V21a.75.75 0 0 1-.75.75h-4a.75.75 0 0 1-.75-.75v-7a1.25 1.25 0 0 0-2.5 0v7a.75.75 0 0 1-.75.75h-4a.75.75 0 0 1-.75-.75V8Zm1.5.75v11.5h2.5V14a2.75 2.75 0 1 1 5.5 0v6.25h2.5v-7.87c0-1.904-1.661-3.408-3.57-3.234a6.31 6.31 0 0 0-1.904.48l-1.48.635a.75.75 0 0 1-1.046-.69V8.75h-2.5Z";

const channels = [
  { kind: "mail", label: "email", detail: presentation.mail, href: `mailto:${presentation.mail}` },
  { kind: "github", label: "github", detail: "@AarhamH", href: presentation.socials[0].link, external: true },
  { kind: "linkedin", label: "linkedin", detail: "aarham haider", href: presentation.socials[1].link, external: true },
  { kind: "resume", label: "résumé", detail: "on DocSend", href: presentation.resume, external: true },
];
---

<div class="card">
  <svg class="frame wobble" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="ink muted" d={rectPath(100, 100, 88, 0.6)} vector-effect="non-scaling-stroke"></path>
  </svg>

  <div class="intro">
    <h2 id="contact-title">hit me up</h2>
    <p>
      Open to discussing upcoming projects, or simply to have a chat.
    </p>
    <p class="note">based in {presentation.location}</p>
  </div>

  <ul role="list" class="channels">
    {
      channels.map((channel) => (
        <li>
          <a href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noreferrer" : undefined}>
            <svg class:list={["icon", { filled: channel.kind === "github" || channel.kind === "linkedin" }]} viewBox="0 0 24 24" aria-hidden="true">
              {channel.kind === "mail" && <path d="M3 6.5 L21 6 L20.6 18.2 L3.4 18.5 Z M3.4 7 L12 13.2 L20.6 6.6" />}
              {channel.kind === "github" && <path d={siGithub.path} />}
              {channel.kind === "linkedin" && <path d={linkedinPath} fill-rule="evenodd" />}
              {channel.kind === "resume" && <path d="M6 3 L15 3 L19 7 L18.6 21 L5.6 21 Z M15 3 L15 7 L19 7 M8.5 11 L15.5 11 M8.5 14 L15.5 14 M8.5 17 L13 17" />}
            </svg>
            <span class="label">{channel.label}</span>
            <span class="detail">{channel.detail}</span>
            {channel.external && <span class="visually-hidden"> (opens in a new tab)</span>}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-5);
  }

  @media (min-width: 48rem) {
    .card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: center;
      gap: var(--space-7);
      padding: var(--space-7);
    }
  }

  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .intro {
    display: grid;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .intro p:not(.note) {
    color: var(--color-muted);
  }

  .channels {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .channels li + li {
    border-top: 1px dashed var(--color-rule);
  }

  .channels a {
    display: grid;
    grid-template-columns: 1.75rem 6rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-1);
    background: none;
    color: var(--color-chalk);
  }

  .icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--color-chalk);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: url(#wobble);
    transition: transform 200ms var(--draw-ease);
  }

  .icon.filled {
    fill: var(--color-chalk);
    stroke: none;
    filter: url(#chalk);
  }

  .label {
    font-family: var(--font-script);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
  }

  .detail {
    overflow-wrap: anywhere;
    color: var(--color-muted);
  }

  .channels a:hover .label,
  .channels a:hover .detail {
    color: var(--color-accent);
  }

  .channels a:hover .icon {
    transform: rotate(-8deg);
  }

  @media (max-width: 30rem) {
    .channels a {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      row-gap: 0;
    }

    .detail {
      grid-column: 2;
    }
  }
</style>
